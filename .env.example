# =============================================================================
# RentFlow 2.0 – Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit .env with real secrets to source control.
# =============================================================================

# Database Configuration (PostgreSQL)
DB_NAME=rentflow
DB_USERNAME=rentflow_user
DB_PASSWORD=your_secure_db_password_here
HOST_DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/rentflow

# JWT Security
# Generate a strong 256-bit secret key encoded in Base64:
# e.g., openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256bit_secret_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8080
