# =============================================================================
# RentFlow 2.0 – Production Environment Configuration Template
# Copy this file to .env and replace placeholders with strong, unique secrets:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit .env with real secrets to source control.
# - In production, both DB_PASSWORD and JWT_SECRET are strictly required.
# =============================================================================

# Database Configuration (PostgreSQL)
DB_NAME=rentflow
DB_USERNAME=rentflow_user
DB_PASSWORD=replace_with_a_strong_database_password
HOST_DB_PORT=5433

# JWT Security
# Generate a secure 256-bit (32 bytes) Base64 string with:
#   Linux/macOS: openssl rand -base64 32
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=replace_with_a_secure_base64_encoded_256bit_secret_key
JWT_EXPIRATION_MS=3600000

# Web Gateway / CORS Configuration
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
